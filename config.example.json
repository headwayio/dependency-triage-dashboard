{
  "org": "your-github-org",
  "host": "127.0.0.1",
  "port": 8787,
  "workDir": ".work",
  "branchPrefix": "dependency-updates/soc2",
  "draftPRs": true,
  "closeObsoletePRs": true,
  "nudgeDependabotOnClear": true,
  "minimizeMajorBumps": true,
  "alertState": "open",
  "includeRepos": [],
  "excludeRepos": [],
  "autoInstallRuby": true,
  "autoInstallNode": true,
  "autoInstallGo": true,
  "autoInstallPhp": true,
  "emailHourlyRate": 200,
  "npm": { "force": false },
  "autoFixCI": false,
  "ciPollSeconds": 90,
  "maxConcurrentUpdates": 3,
  "maxConcurrentFixes": 1,
  "dismissToken": "",
  "claudeFix": { "permissionMode": "auto", "timeoutMinutes": 12, "maxAttemptsPerSha": 2, "maxAttemptsPerRepo": 4 },
  "autoUpgradeEOL": false,
  "eolPollHours": 12,
  "autoFixGemConstraints": false,
  "claudeBump": { "permissionMode": "auto", "timeoutMinutes": 20 },
  "protection": {
    "rulesetName": "SOC 2 — protected default branch",
    "requiredApprovals": 1,
    "dismissStaleReviews": true,
    "requireConversationResolution": true,
    "blockForcePush": true,
    "restrictDeletion": true,
    "requireCodeOwnerReview": false,
    "allowAdminBypass": false
  }
}
