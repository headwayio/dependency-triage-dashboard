#!/usr/bin/env node
"use strict";

// A stand-in for the `gh` CLI, put first on PATH so the REAL server.js runs against it.
// Nothing here touches GitHub, so tests can exercise destructive routes (merge, rollup,
// dismiss) without a network or a victim repo.
//
// Two channels control it:
//   GH_STUB_DIR    a scratch dir. `scenario` in it names the fixture variation to serve;
//                  every invocation is appended to `gh.log` as one argv line, so a test can
//                  assert on the exact command — which is the point. Asserting the response
//                  body only proves we reported a merge; asserting the argv proves we asked
//                  for the right one (`--squash` vs `--merge`, `--delete-branch` or not).
//   GH_STUB_ORG    the org name the fixtures answer for.
//
// Add a scenario by adding a branch below; the fixtures are deliberately small and literal
// so a test reads as "given this repo state, we expect this command".

const fs = require("fs");
const path = require("path");

const argv = process.argv.slice(2);
const joined = argv.join(" ");
const DIR = process.env.GH_STUB_DIR || "";
const ORG = process.env.GH_STUB_ORG || "acme-corp";
const read = (f, d = "") => { try { return fs.readFileSync(path.join(DIR, f), "utf8").trim(); } catch { return d; } };
const scenario = read("scenario", "default");

if (DIR) { try { fs.appendFileSync(path.join(DIR, "gh.log"), joined + "\n"); } catch { /* best effort */ } }

const out = (v) => { process.stdout.write(typeof v === "string" ? v : JSON.stringify(v)); process.exit(0); };
const fail = (msg) => { process.stderr.write(msg.endsWith("\n") ? msg : msg + "\n"); process.exit(1); };

// ---- fixtures ---------------------------------------------------------------
const REPO = "data-pipeline";
const TOOL_BRANCH = "dependency-updates/soc2-2026-07-20";

// One PR per state the routes have to distinguish. `number` doubles as the test's handle.
// Shared by `pr view` and `pr list`, so a PR can't behave one way when inspected and another
// when listed — a divergence there would let a test pass against a contradiction.
const PRS = {
  57: { state: "OPEN", isDraft: false, reviewDecision: "APPROVED", headRefName: TOOL_BRANCH,
        title: "Bump cryptography + jinja2" },
  58: { state: "OPEN", isDraft: false, reviewDecision: "APPROVED", headRefName: "feature/checkout-redesign",
        title: "Human feature work" },                      // not a tool branch — never touch it
  59: { state: "MERGED", isDraft: false, reviewDecision: "APPROVED", headRefName: "dependency-updates/soc2-2026-07-01",
        title: "Already merged" },
  60: { state: "OPEN", isDraft: false, reviewDecision: "CHANGES_REQUESTED", headRefName: "dependency-updates/soc2-2026-07-25",
        title: "Contested bump" },
  61: { state: "OPEN", isDraft: true, reviewDecision: "APPROVED", headRefName: "dependency-updates/soc2-2026-07-26",
        title: "Draft bump" },
  90: { state: "OPEN", isDraft: false, reviewDecision: null, headRefName: "dependency-updates/soc2-2026-07-21",
        title: "Stacked bump", baseRefName: TOOL_BRANCH },
  300: { state: "OPEN", isDraft: false, reviewDecision: null, headRefName: "release/deps-2026-07-01",
         title: "Release rollup" },                         // a rollup is not a rollup INPUT
  // Dependabot's own version-update PRs — routine bumps with no advisory. The tool never
  // acts on these, but it counts them, so the spread covers what the count has to
  // distinguish: two ecosystems plus CI plumbing, a major, and one that's red.
  201: { state: "OPEN", isDraft: false, reviewDecision: null, headRefName: "dependabot/bundler/puma-8.0.2",
         title: "Bump puma from 7.2.1 to 8.0.2", checks: ["SUCCESS"], lock: "Gemfile.lock", createdAt: "2026-05-02T00:00:00Z" },
  202: { state: "OPEN", isDraft: false, reviewDecision: null, headRefName: "dependabot/bundler/jbuilder-2.15.1",
         title: "Bump jbuilder from 2.14.1 to 2.15.1", checks: ["FAILURE"], lock: "Gemfile.lock", createdAt: "2026-06-11T00:00:00Z" },
  203: { state: "OPEN", isDraft: false, reviewDecision: null, headRefName: "dependabot/npm_and_yarn/sortablejs-1.15.7",
         title: "Bump sortablejs from 1.15.0 to 1.15.7", checks: [], lock: "package-lock.json", createdAt: "2026-07-01T00:00:00Z" },
  204: { state: "OPEN", isDraft: false, reviewDecision: null, headRefName: "dependabot/github_actions/actions/checkout-7",
         title: "Bump actions/checkout from 4 to 7", checks: ["SUCCESS"], lock: null, createdAt: "2026-07-05T00:00:00Z" },
};
for (const [n, pr] of Object.entries(PRS)) {
  pr.number = Number(n);
  pr.baseRefName = pr.baseRefName || "main";
  pr.url = `https://github.com/${ORG}/${REPO}/pull/${n}`;
  // Derived from the number so PRs have a stable, distinct order — but never clobber an
  // explicit date, because for the Dependabot fixtures age IS the thing under test.
  pr.createdAt = pr.createdAt || `2026-07-${String(10 + (Number(n) % 20)).padStart(2, "0")}T00:00:00Z`;
}

// Review threads per PR, for the CI/review poll. 57 carries the shape that caused the bug:
// a thread that is unresolved but OUTDATED. Our own pushes outdate threads constantly, so
// this is the normal state of a PR that has been fixed once and still has open feedback.
const THREADS = {
  57: [
    { isResolved: false, isOutdated: false }, // plainly open
    { isResolved: false, isOutdated: true },  // open, but its anchor line moved
    { isResolved: true, isOutdated: true },   // done — must never count
  ],
  90: [{ isResolved: true, isOutdated: false }],
};

// Which PRs are OPEN on the repo, per scenario. Order here is gh's listing order, so a route
// that reorders (rollup honors the caller's merge order) can be caught doing it.
const OPEN_PRS = {
  default: [57, 201, 202, 203, 204],
  "no-dependabot-prs": [57],
  // Nothing of OURS open — the case a backlog actually accumulates in, since no tool PR
  // draws the eye to the repo.
  "only-dependabot": [201, 202, 203, 204],
  "tool-child": [90, 57],
  // Every category the rollup filter must reject, alongside two it must accept.
  "rollup-mix": [57, 90, 58, 60, 61, 300, 201],
  "rollup-one": [57],
  "release-pr-open": [57, 90], // two eligible, so the route proceeds and the JOB does the skipping
  "slow-clone": [90, 57],      // pairs with the stalling clone below, for the concurrency test
};
const listFor = (s) => (OPEN_PRS[s] || OPEN_PRS.default).map((n) => {
  const pr = PRS[n];
  const bot = pr.headRefName.startsWith("dependabot/");
  return {
    ...pr,
    isDraft: pr.isDraft,
    reviewRequests: [],
    files: bot ? (pr.lock ? [{ path: pr.lock }] : []) : [{ path: "requirements.txt" }, { path: "poetry.lock" }],
    author: { login: bot ? "app/dependabot" : "dev-user" },
    statusCheckRollup: (pr.checks || []).map((c) => ({ conclusion: c })),
  };
});

// What `gh repo view --json <merge flags>` reports. "unreadable" exits non-zero so the route's
// can't-tell fallback is exercised; "none-allowed" answers with every method disabled, which is
// a different thing and must not be confused with it.
const MERGE_CAPS = {
  default: { squashMergeAllowed: true, mergeCommitAllowed: true, rebaseMergeAllowed: true },
  "no-squash": { squashMergeAllowed: false, mergeCommitAllowed: true, rebaseMergeAllowed: true },
  "rebase-only": { squashMergeAllowed: false, mergeCommitAllowed: false, rebaseMergeAllowed: true },
  "none-allowed": { squashMergeAllowed: false, mergeCommitAllowed: false, rebaseMergeAllowed: false },
};

// An open PR whose base IS PR 57's head branch, i.e. something stacked on it. "tool-child" is
// one of ours; "human-child" is not — the model cache only holds ours, so only a live GitHub
// query can see the second, and that difference is the reason the route asks GitHub.
const STACK_CHILD = { "tool-child": 90, "human-child": 99 };

// ---- routes -----------------------------------------------------------------
const is = (...words) => words.every((w, i) => argv[i] === w);

if (is("api") && argv[1] === "user") out("test-user\n");

if (is("api") && joined.includes("dependabot/alerts")) {
  out(JSON.stringify({
    repoName: REPO, ghsa: "GHSA-abab-1414-mman", severity: "critical", pkg: "cryptography",
    ecosystem: "pip", patched: "44.0.1", patchedVersions: ["44.0.1"],
    manifest: "requirements.txt", summary: "Vulnerability in cryptography", url: "https://example.test/ghsa",
  }) + "\n");
}
// The batched CI + review poll (lib/ci.js fetchPRStatusBatch). It aliases one block per PR
// as p0, p1, …; answer in the same order by reading the numbers back out of the query.
if (is("api", "graphql")) {
  const q = argv.find((a) => a.startsWith("query=")) || "";
  const nums = [...q.matchAll(/pullRequest\(number:\s*(\d+)\)/g)].map((m) => Number(m[1]));
  if (!nums.length) out({ data: {} });
  const data = {};
  nums.forEach((n, i) => {
    const pr = PRS[n];
    data[`p${i}`] = pr
      ? { pullRequest: {
          isDraft: pr.isDraft, reviewDecision: pr.reviewDecision, headRefOid: `sha-${n}`,
          mergeable: "MERGEABLE", mergeStateStatus: "CLEAN", baseRefName: pr.baseRefName,
          reviewThreads: { nodes: THREADS[n] || [] },
          reviewRequests: { nodes: [] },
          commits: { nodes: [{ commit: { statusCheckRollup: { contexts: { nodes: [
            { __typename: "CheckRun", name: "tests", status: "COMPLETED", conclusion: "SUCCESS", detailsUrl: "" },
          ] } } } }] },
        } }
      : { pullRequest: null };
  });
  out({ data });
}

if (is("api")) out("[]"); // members, contents, and anything else best-effort

if (is("repo", "list")) {
  out([{
    name: REPO, nameWithOwner: `${ORG}/${REPO}`, isArchived: false, isFork: false,
    pushedAt: "2026-07-20T00:00:00Z", defaultBranchRef: { name: "main" },
    primaryLanguage: { name: "Python" }, description: "", visibility: "PRIVATE",
    url: `https://github.com/${ORG}/${REPO}`,
  }]);
}

if (is("repo", "view")) {
  if (scenario === "caps-unreadable") fail("HTTP 502: could not read repository");
  out(MERGE_CAPS[scenario] || MERGE_CAPS.default);
}

// `pr list --base X` is the "is anything stacked on this?" probe. Answer it before the general
// listing, which is the model build.
if (is("pr", "list") && argv.includes("--base")) {
  const base = argv[argv.indexOf("--base") + 1];
  const child = STACK_CHILD[scenario];
  out(child && base === TOOL_BRANCH ? [{ number: child }] : []);
}

// `pr list --head release/deps-…` is the rollup's "is a release PR already open?" guard.
// It must answer EMPTY by default: falling through to the general listing below would hand
// back an unrelated PR, the rollup would read it as an existing release and skip itself, and
// every rollup test would silently pass without testing a rollup.
if (is("pr", "list") && argv.includes("--head")) {
  const head = argv[argv.indexOf("--head") + 1];
  out(scenario === "release-pr-open" && head.startsWith("release/deps-")
    ? [{ number: 300, url: `https://github.com/${ORG}/${REPO}/pull/300` }]
    : []);
}

// A rollup/consolidate/rebase job clones before doing anything, so the stub has to leave a
// real repository behind or the job dies on its first git call and never reaches the logic
// under test. An empty `git init` is enough: branch creation works, and the per-PR fetches
// then fail against the absent remote, which is the path that logs each PR in order and
// aborts before any Claude session.
if (is("repo", "clone")) {
  const dest = argv[3];
  // Hold the job open long enough that a test about concurrent requests doesn't depend on
  // winning a race with it. Without this the assertion is "the second request arrives before
  // the first job finishes", which is true in practice and therefore a latent flake.
  if (scenario === "slow-clone") {
    Atomics.wait(new Int32Array(new SharedArrayBuffer(4)), 0, 0, 1500);
  }
  try {
    fs.mkdirSync(dest, { recursive: true });
    require("child_process").execFileSync("git", ["init", "-q", dest], { stdio: "ignore" });
  } catch (e) { fail(`stub clone failed: ${e.message}`); }
  out(`Cloning into '${dest}'...\n`);
}

// The narrow count query the staleness explainer uses. Derived from the same listing the
// model build sees, so the card and the explanation can never disagree about what's open.
if (is("pr", "list") && joined.includes("--author app/dependabot")) {
  out(listFor(scenario).filter((p) => p.headRefName.startsWith("dependabot/")));
}

if (is("pr", "list")) {
  if (joined.includes("--state all")) out([]); // reviewer-history lookup
  out(listFor(scenario));
}

if (is("pr", "view")) {
  if (scenario === "view-fails") fail("could not resolve to a PullRequest with the number of 57");
  const pr = PRS[Number(argv[2])];
  if (!pr) fail(`no pull request found for #${argv[2]}`);
  if (argv.includes("--jq")) out(pr.headRefName + "\n"); // prBranch()
  out(pr);
}

if (is("pr", "merge")) {
  if (scenario === "merge-blocked") {
    fail("GraphQL: Pull request is not mergeable: 1 of 2 required status checks have not passed. (mergePullRequest)");
  }
  out(`✓ Merged pull request ${ORG}/${REPO}#${argv[2]}\n`);
}

out(""); // anything unrecognised succeeds silently rather than failing a test for the wrong reason
